---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import Screenshot from '../components/Screenshot.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  [
    'Your student makes their account',
    'Parent access always starts from the student. They join Mascot AI and set up their profile first.',
  ],
  [
    'Link the two accounts',
    "Send a request from your dashboard using your student's account email, or have them invite you from their settings.",
  ],
  [
    'They accept',
    'Once your student accepts, you get a read-only view of their profile and progress, plus billing management. Either of you can unlink at any time.',
  ],
];
---

<BaseLayout
  path="/parents/"
  title="Mascot AI for Parents: Follow Your Student's College Progress"
  description="Link your account to your student's and get a read-only view of their profile, application progress, and college matches, plus billing for the subscription. Students stay in control of their work."
>
  <section class="container-x py-16 text-center sm:py-20">
    <h1 class="text-4xl sm:text-5xl">For parents</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-text-tertiary">
      Link your account to your student's and follow the college process without running it. You get
      a read-only view of their profile and progress, and you handle the subscription. Everything
      your student builds stays theirs.
    </p>
  </section>

  <FeatureBlock
    eyebrow="Your dashboard"
    title="One dashboard for every student you link"
    body="Each student you link to shows up with their college planning status. Add a student by email, accept the ones who invite you, and open any of them to see where things stand."
    bullets={[
      'Link by email, or accept a request from your student',
      'A card per student, with profile and billing one click away',
      'Link and unlink at any time, from either side',
    ]}
  >
    <BrowserFrame label="app.mascot-ai.com">
      <Screenshot
        src="/screenshots/parents-home.jpg"
        alt="The Mascot AI parent dashboard listing a linked student with buttons for profile and billing"
        width={1315}
        height={924}
      />
    </BrowserFrame>
  </FeatureBlock>

  <FeatureBlock
    reverse
    eyebrow="Read-only access"
    title="Their profile and progress, read-only"
    body="Open a student to see the same profile they see: academics, test scores, activities, honors, and the story they're building with Mascot. An onboarding score and a breakdown by section show what's done and what's still missing. You can look but you can't edit."
    bullets={[
      'Academics, testing, activities, and honors in one view',
      'Onboarding completion and which sections are incomplete',
      'University matches when your student shares them',
    ]}
  >
    <BrowserFrame label="app.mascot-ai.com">
      <Screenshot
        src="/screenshots/parents-profile.jpg"
        alt="A read-only student profile in Mascot AI showing 100 percent onboarding completion and section cards for academics, test scores, activities, and honors"
        width={1315}
        height={924}
      />
    </BrowserFrame>
  </FeatureBlock>

  <FeatureBlock
    eyebrow="Billing"
    title="Take the subscription off your student's plate"
    body="While your link is active you manage your student's plan: check the current tier and usage, change plans, and buy add-ons. The student can reclaim billing whenever they want."
    bullets={[
      'Current plan and usage for the period',
      'Change plans and buy add-ons for your student',
      'Student can take billing back at any time',
    ]}
  >
    <BrowserFrame label="app.mascot-ai.com">
      <Screenshot
        src="/screenshots/parents-billing.jpg"
        alt="The Mascot AI billing view for a parent showing the student's current plan, usage bars, and upgrade options"
        width={1315}
        height={924}
      />
    </BrowserFrame>
  </FeatureBlock>

  <section class="border-b border-border-primary bg-bg-secondary py-16">
    <div class="container-x max-w-3xl">
      <h2 class="text-2xl">How linking works</h2>
      <ol class="mt-8 space-y-8" data-anim-group>
        {
          steps.map(([t, d], i) => (
            <li class="flex gap-5" data-anim>
              <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-brand-primary/10 font-headline text-sm font-bold text-brand-primary">
                {i + 1}
              </span>
              <div>
                <h3 class="font-headline text-lg">{t}</h3>
                <p class="mt-1 leading-relaxed text-text-tertiary">{d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-sm text-text-muted">
        Parents are always read-only. You can view what your student shares and manage the
        subscription. You cannot create, edit, or delete their profile, essays, or matches.
      </p>
    </div>
  </section>

  <CtaBand
    title="Get your student started"
    subtitle="Request beta access, then link your account once they're in."
  />
</BaseLayout>
