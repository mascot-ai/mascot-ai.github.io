---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import ShotPlaceholder from '../components/ShotPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  ['Your student invites you', 'They add your email from their account. You get a link to accept — no new student data entered twice.'],
  ['You approve and connect', 'Create a free parent account (or sign in) and accept the link. Minors go through a parental-consent step.'],
  ['You follow along', 'See their profile, college matches, and essays, read-only. Manage billing if you want to.'],
];

const canDo = [
  'View your student\'s profile, matches, and essays',
  'See which sections they\'ve shared with you',
  'Hold the subscription, or transfer it back to your student',
  'Reach support for privacy or billing questions',
];
const cantDo = [
  'Edit or delete your student\'s content',
  'Talk to Mascot or run AI features on their behalf',
  'See sections your student hasn\'t shared',
];
---

<BaseLayout
  path="/for-parents"
  title="For Parents — Mascot AI"
  description="Link to your student with their approval and follow their college process read-only. Parent accounts are free."
>
  <section class="container-x py-16 sm:py-20">
    <p class="eyebrow">For Parents</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">
      Stay involved without taking over
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-tertiary">
      Mascot AI gives parents a read-only window into their student's college process. You see
      the profile, the matches, and the essays. You never edit them. Your account is free.
    </p>
  </section>

  <section class="border-y border-border-primary bg-bg-secondary py-16">
    <div class="container-x">
      <h2 class="text-2xl">How linking works</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-3" data-anim-group>
        {
          steps.map(([t, d], i) => (
            <li class="rounded-2xl border border-border-primary bg-bg-card p-6" data-anim>
              <span class="font-headline text-sm font-bold text-brand-primary">0{i + 1}</span>
              <h3 class="mt-2 font-headline text-lg">{t}</h3>
              <p class="mt-2 text-sm text-text-tertiary">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-x grid items-center gap-12 py-16 lg:grid-cols-2 lg:gap-16">
    <div data-anim>
      <BrowserFrame label="app.mascot-ai.com/parent">
        <ShotPlaceholder name="Parent read-only student view" />
      </BrowserFrame>
    </div>
    <div class="grid gap-6 sm:grid-cols-2" data-anim>
      <div>
        <h2 class="text-lg">What you can do</h2>
        <ul class="mt-3 space-y-2 text-sm text-text-secondary">
          {canDo.map((x) => (
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{x}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-lg">What you can't</h2>
        <ul class="mt-3 space-y-2 text-sm text-text-secondary">
          {cantDo.map((x) => (
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <span>{x}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-x pb-16">
    <div class="rounded-2xl border border-border-primary bg-bg-secondary p-6 text-sm text-text-tertiary">
      <strong class="text-text-primary">Billing.</strong> Either the student or a linked parent can
      hold the Navigator subscription, and it can be transferred between you at any time. Parent
      accounts themselves are always free.
    </div>
  </section>

  <CtaBand title="Have your student send you a link" subtitle="They can invite you from their account today." />
</BaseLayout>
