---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import Screenshot from '../components/Screenshot.astro';
import VoiceRecreation from '../components/VoiceRecreation.astro';
import RadarChart from '../components/RadarChart.astro';
import CtaBand from '../components/CtaBand.astro';
import { BETA_FORM_URL, APP_LOGIN_URL, TOTAL_UNIVERSITIES, PRICING } from '../lib/site.js';
---

<BaseLayout path="/">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_50%_0%,rgb(var(--color-brand-primary)/0.12),transparent)]"
    >
    </div>
    <div class="container-x grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-2 lg:gap-16">
      <div>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-border-primary bg-bg-card px-3 py-1 text-xs font-medium text-text-secondary"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand-secondary"></span> Now in private beta
        </span>
        <h1 class="mt-5 text-4xl leading-[1.08] sm:text-5xl md:text-6xl">
          Talk through college.<br />Mascot handles the rest.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-text-tertiary">
          Mascot is a voice-first counselor for high schoolers. Talk through your goals, get a
          college list that fits, and write stronger essays. All in one app.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={BETA_FORM_URL} target="_blank" rel="noopener" class="btn-primary">Request beta access</a>
          <a href={APP_LOGIN_URL} class="btn-ghost">Log in</a>
        </div>
      </div>
      <div data-anim>
        <VoiceRecreation />
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-border-primary bg-bg-secondary">
    <div
      class="container-x grid gap-4 py-6 text-center text-sm text-text-secondary sm:grid-cols-2 lg:grid-cols-4"
      data-anim-group
    >
      <p data-anim>
        <span class="font-headline text-lg font-bold text-text-primary" data-count="4800" data-suffix="+"
          >{TOTAL_UNIVERSITIES}</span
        > universities
      </p>
      <p data-anim>Voice, matching, and essays in one place</p>
      <p data-anim>Built with 20 students and 2 school counselors</p>
      <p data-anim>Free to start</p>
    </div>
  </section>

  <!-- Feature teasers. Detail lives on /features. -->
  <FeatureBlock
    eyebrow="Talk to Mascot"
    title="A counselor you can actually talk to"
    body="Have real voice conversations about your goals and activities. Mascot remembers every session and turns what you say into a profile."
  >
    <VoiceRecreation
      lines={[
        { who: 'mascot', text: 'Last time you mentioned debate. How did that go this month?' },
        { who: 'you', text: 'We won regionals and I started coaching the novice team.' },
        { who: 'mascot', text: "Coaching is a leadership signal. I'll add it to your story." },
      ]}
    />
  </FeatureBlock>

  <FeatureBlock
    reverse
    eyebrow="AI Matching"
    title="A college list that fits you"
    body="Mascot ranks schools against your whole profile and gives a reason for every match. Regenerate it whenever your profile changes."
  >
    <BrowserFrame label="app.mascot-ai.com/matches">
      <Screenshot src="/screenshots/matches.jpg" alt="Mascot AI matches split into reach, target, and safety schools" />
    </BrowserFrame>
  </FeatureBlock>

  <FeatureBlock
    eyebrow="Explore"
    title={`${TOTAL_UNIVERSITIES} schools, in real depth`}
    body="Filter by location, size, selectivity, and major. Open any school for six tabs of real data, then save the ones you like."
  >
    <BrowserFrame label="app.mascot-ai.com/universities">
      <Screenshot src="/screenshots/university-detail.jpg" alt="A university detail view in Mascot AI with tabbed sections" />
    </BrowserFrame>
  </FeatureBlock>

  <FeatureBlock
    reverse
    eyebrow="Essays"
    title="Write with a coach a click away"
    body="Draft in a clean editor. Run a full analysis, talk a paragraph through with Mascot, or pull evidence from your own activities. Writing is always free."
  >
    <BrowserFrame label="app.mascot-ai.com/essays">
      <Screenshot src="/screenshots/essays.jpg" alt="The Mascot AI essay workspace with a draft and formatting toolbar" />
    </BrowserFrame>
  </FeatureBlock>

  <FeatureBlock
    eyebrow="Your Profile"
    title="Build it once, by talking or typing"
    body="A guided setup covers grades, tests, courses, activities, and goals. Upload a transcript and Mascot parses it, or do the whole thing by voice."
  >
    <BrowserFrame label="app.mascot-ai.com">
      <Screenshot src="/screenshots/dashboard.jpg" alt="The Mascot AI dashboard with profile completion and next steps" width={1354} height={908} />
    </BrowserFrame>
  </FeatureBlock>

  <!-- Story coverage -->
  <section class="border-b border-border-primary py-20 sm:py-28">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-anim>
        <p class="eyebrow">Story coverage</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Every conversation fills in your story</h2>
        <p class="mt-4 text-lg leading-relaxed text-text-tertiary">
          Mascot tracks seven parts of your story, from your proudest accomplishment to your
          future goals, and steers each conversation toward the ones you have covered least.
        </p>
      </div>
      <div data-anim>
        <RadarChart />
      </div>
    </div>
  </section>

  <!-- Pricing preview -->
  <section class="border-b border-border-primary py-20 sm:py-24">
    <div class="container-x">
      <div class="text-center" data-anim>
        <p class="eyebrow">Pricing</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Start free. Upgrade when you're ready.</h2>
      </div>
      <div class="mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-2" data-anim-group>
        <div class="rounded-2xl border border-border-primary bg-bg-card p-6" data-anim>
          <h3 class="font-headline text-lg">Explorer</h3>
          <p class="mt-1 text-2xl font-bold">Free</p>
          <ul class="mt-4 space-y-2 text-sm text-text-secondary">
            <li>Profile builder with voice</li>
            <li>University search and browse</li>
            <li>Unlimited essays and drafts</li>
            <li>1 AI match run a month, 60 voice minutes</li>
          </ul>
        </div>
        <div class="relative rounded-2xl border border-brand-primary bg-bg-card p-6" data-anim>
          {!PRICING.navigatorLive && (
            <span class="absolute -top-3 left-6 rounded-full bg-brand-primary px-3 py-1 text-xs font-bold text-white">Coming soon</span>
          )}
          <h3 class="font-headline text-lg">Navigator</h3>
          <p class="mt-1 text-2xl font-bold">{PRICING.navigatorMonthly}<span class="text-sm font-normal text-text-muted">/mo</span></p>
          <ul class="mt-4 space-y-2 text-sm text-text-secondary">
            <li>Everything in Explorer, plus:</li>
            <li>Unlimited AI match runs</li>
            <li>25 saved universities</li>
            <li>Essay AI slots and 2 essays coached at once</li>
          </ul>
        </div>
      </div>
      <p class="mt-8 text-center text-sm" data-anim>
        <a href="/pricing" class="font-semibold text-brand-primary hover:underline">See full pricing &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Roadmap strip -->
  <section class="border-b border-border-primary bg-bg-secondary py-12">
    <div class="container-x flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left" data-anim>
      <p class="text-sm text-text-secondary">
        <span class="font-semibold text-text-primary">On the roadmap:</span> parent access, a
        counselor workspace, and a scholarship finder.
      </p>
      <a href="/coming-soon" class="btn-ghost !py-2 text-sm">See what's next</a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
