---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, APP_URL, BETA_FORM_URL } from '../lib/site.js';
---

<BaseLayout
  path="/contact/"
  title="Contact Mascot AI"
  description="Reach the Mascot AI team with questions, product feedback, a privacy request, or to ask about private beta access."
>
  <section class="container-x max-w-2xl py-16 sm:py-24">
    <h1 class="text-4xl sm:text-5xl">Contact us</h1>
    <p class="mt-4 text-lg text-text-tertiary">
      Have a question, feedback, or a privacy request? Send it over and we'll get back to you.
    </p>

    <div class="mt-10 space-y-3">
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="flex items-center gap-4 rounded-2xl border border-border-primary bg-bg-card p-5 transition-colors hover:bg-bg-tertiary"
      >
        <svg class="h-6 w-6 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        <span>
          <span class="block text-xs font-semibold uppercase tracking-wider text-text-muted">Email</span>
          <span class="text-text-primary">{CONTACT_EMAIL}</span>
        </span>
      </a>

      <a
        href={BETA_FORM_URL}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-4 rounded-2xl border border-border-primary bg-bg-card p-5 transition-colors hover:bg-bg-tertiary"
      >
        <svg class="h-6 w-6 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1 2 3 6 3s6-2 6-3v-5"/></svg>
        <span>
          <span class="block text-xs font-semibold uppercase tracking-wider text-text-muted">Request beta access</span>
          <span class="text-text-primary">Students: join the private beta</span>
        </span>
      </a>

      <a
        href={APP_URL}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-4 rounded-2xl border border-border-primary bg-bg-card p-5 transition-colors hover:bg-bg-tertiary"
      >
        <svg class="h-6 w-6 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        <span>
          <span class="block text-xs font-semibold uppercase tracking-wider text-text-muted">Existing beta users</span>
          <span class="text-text-primary">dev.mascot-ai.com</span>
        </span>
      </a>
    </div>

    <p class="mt-8 rounded-xl bg-bg-secondary p-4 text-sm text-text-tertiary">
      We usually respond within 2 to 3 business days. For privacy or data deletion requests we
      respond within 30 days, as required by GDPR and CCPA.
    </p>
  </section>
</BaseLayout>
