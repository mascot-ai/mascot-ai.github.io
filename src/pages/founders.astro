---
// TEMP: grant page. Unlisted (noindex, not in sitemap/llms.txt, linked from /about/ and the footer).
// Remove this file, public/founders/, the link at the bottom of about.astro, and the footer link after the grant decision.
// Copy rule: schools yes, employers and metrics no. Keep the "building" lines generic.
import BaseLayout from '../layouts/BaseLayout.astro';

const founders = [
  {
    name: 'Pranav Lodha',
    role: 'CEO',
    photo: '/founders/pranav.png',
    bio: 'Pranav has spent his career building resilient cloud infrastructure and AI-powered products. At Mascot AI he leads the company and the product, which he built to give students real guidance and the confidence to apply to the school they choose.',
    path: [
      ['High school', 'Mission San Jose High School', 'Fremont, CA'],
      ['Bachelor\'s', 'University of California, Santa Cruz', ''],
      ['Master\'s', 'San Jose State University', ''],
      ['MBA', 'UCLA Anderson School of Management', ''],
    ],
  },
  {
    name: 'Nikhil Sathe',
    role: 'COO',
    photo: '/founders/nikhil.png',
    bio: 'Nikhil has spent his career building hardware, along with the automation tools that engineers use to design it. At Mascot AI he runs operations, and he works on Mascot so that every student can get good guidance.',
    path: [
      ['High school', 'Monta Vista High School', 'Cupertino, CA'],
      ['Bachelor\'s', 'University of California, Berkeley', ''],
      ['Master\'s', 'University of Michigan, Ann Arbor', ''],
    ],
  },
];

const principles = [
  [
    'Students write every word',
    'Mascot asks questions and gives feedback. It does not write essays or hand over sentences to paste in.',
    'M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z',
  ],
  [
    'Confidence, not shortcuts',
    'A student should be able to say "this is mine" and apply to the school they actually want.',
    'M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4Z',
  ],
  [
    'Open to every family',
    'Good counseling should not depend on what a family can afford.',
    'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  ],
];
---

<BaseLayout
  path="/founders/"
  title="Founders | Mascot AI"
  description="The people behind Mascot AI."
  noindex={true}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-24 h-[28rem] bg-[radial-gradient(60%_60%_at_50%_0%,rgb(var(--color-brand-primary)/0.18),transparent)]"
      aria-hidden="true"
    >
    </div>
    <div class="container-x relative py-20 text-center sm:py-28">
      <p class="eyebrow">Meet the founders</p>
      <h1 class="mx-auto mt-4 max-w-3xl text-4xl leading-tight sm:text-6xl">
        Two builders, <span class="text-brand-primary">working for students.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-text-tertiary">
        We are not educators by training. We build things, and Mascot is the one we built for
        students. Below is where we studied and what we have spent our careers making.
      </p>
    </div>
  </section>

  <!-- Founders -->
  <section class="border-y border-border-primary bg-bg-secondary py-16 sm:py-20">
    <div class="container-x">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2" data-anim-group>
        {
          founders.map((f) => (
            <article class="flex flex-col md:row-span-3 md:grid md:grid-rows-subgrid md:gap-y-0 rounded-3xl border border-border-primary bg-bg-card p-8 shadow-sm transition-shadow duration-200 hover:shadow-lg" data-anim>
              <div class="text-center">
                <div class="mx-auto h-44 w-44 overflow-hidden rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary p-1.5 shadow-lg">
                  <div class="h-full w-full overflow-hidden rounded-full bg-bg-card">
                    <img
                      src={f.photo}
                      alt={`Portrait of ${f.name}`}
                      width="402"
                      height="402"
                      class="h-full w-full scale-[1.12] object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
                <h2 class="mt-6 font-headline text-2xl">{f.name}</h2>
                <p class="mt-1 text-sm font-semibold uppercase tracking-wider text-brand-primary">{f.role}</p>
              </div>

              <p class="mt-5 leading-relaxed text-text-tertiary">{f.bio}</p>

              <div class="mt-8">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Where we studied</h3>
                <ol class="relative ml-[7px] mt-5 space-y-5 border-l-2 border-border-primary pl-7">
                {f.path.map(([level, school, place]) => (
                  <li class="relative">
                    <span class="absolute -left-[37px] top-1.5 h-4 w-4 rounded-full bg-brand-primary ring-4 ring-bg-card" aria-hidden="true" />
                    <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">{level}</p>
                    <p class="font-headline text-base font-semibold">{school}</p>
                    {place && <p class="text-sm text-text-tertiary">{place}</p>}
                  </li>
                ))}
                </ol>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="container-x py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Our mission</p>
      <h2 class="mt-3 text-3xl sm:text-4xl">Why we built Mascot</h2>
      <p class="mt-5 text-lg leading-relaxed text-text-tertiary">
        Many students get little or no guidance on their applications. Others are tempted to hand
        the essay to a chatbot, and the result sounds like everyone else. We wanted a third option:
        a counselor that knows the process, listens, and asks the questions that help a student find
        their own story. The AI does not write. The student decides and the student writes.
      </p>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3" data-anim-group>
      {
        principles.map(([t, d, icon]) => (
          <li class="rounded-2xl border border-border-primary bg-bg-card p-7 transition-transform duration-200 hover:-translate-y-1" data-anim>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-primary/10 text-brand-primary">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon} /></svg>
            </span>
            <h3 class="mt-5 font-headline text-lg">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-text-tertiary">{d}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
