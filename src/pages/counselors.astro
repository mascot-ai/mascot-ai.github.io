---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../lib/site.js';

const planned = [
  ['Full caseload view', 'Every student you advise in one roster, with profile and progress at a glance.'],
  ['Matching across students', 'Run AI matching for your whole list, not one student at a time.'],
  ['Outcome tracking', 'Follow applications, deadlines, and decisions across your cohort.'],
  ['Family collaboration', 'Loop in parents with the same read-only access students already control.'],
];
---

<BaseLayout
  path="/counselors"
  title="For Counselors — Mascot AI"
  description="A workspace for school and independent college counselors is on the way. Tell us what you need."
>
  <section class="container-x py-16 sm:py-24">
    <p class="eyebrow">For Counselors</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">A workspace for advisors is on the way</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-tertiary">
      Mascot AI is built for students and parents today. Two school counselors helped shape it, and
      a dedicated counselor product is next. If you advise students, we want to hear how you work.
    </p>
    <a href={`mailto:${CONTACT_EMAIL}?subject=Counselor%20workspace`} class="btn-primary mt-8">Get in touch</a>
  </section>

  <section class="border-t border-border-primary py-16">
    <div class="container-x">
      <h2 class="text-2xl">What we're planning</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2" data-anim-group>
        {
          planned.map(([t, d]) => (
            <div class="rounded-2xl border border-border-primary bg-bg-card p-6" data-anim>
              <h3 class="font-headline text-lg">{t}</h3>
              <p class="mt-2 text-sm text-text-tertiary">{d}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-text-muted">Planned, not yet available. Timing will depend on what we hear from counselors.</p>
    </div>
  </section>
</BaseLayout>
