---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  ['Talk', 'Have voice conversations with Mascot about your interests, activities, and goals. It builds your profile as you go.'],
  ['Match', 'Mascot ranks schools against your full profile and explains why each one fits, so your list stays balanced and honest.'],
  ['Apply', 'Draft essays with a coach, then track deadlines and status for every school in one place.'],
];
---

<BaseLayout
  path="/about"
  title="About: Mascot AI"
  description="Mascot AI brings voice-first college counseling to every student, not just the ones who can afford a private counselor. Built in private beta with students and school counselors."
>
  <section class="container-x py-16 sm:py-24">
    <h1 class="max-w-3xl text-4xl leading-tight sm:text-5xl">
      College counseling shouldn't depend on who you can afford.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-text-tertiary">
      A private college counselor can cost hundreds of dollars an hour, and most students never
      get one. Mascot AI puts a voice-first counselor in every student's pocket. It knows the
      whole application process, remembers every conversation, and works off real data on
      thousands of schools.
    </p>
  </section>

  <section class="border-y border-border-primary bg-bg-secondary py-16">
    <div class="container-x">
      <h2 class="text-2xl">How it works</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-3" data-anim-group>
        {
          steps.map(([t, d], i) => (
            <li class="rounded-2xl border border-border-primary bg-bg-card p-6" data-anim>
              <span class="font-headline text-sm font-bold text-brand-primary">0{i + 1}</span>
              <h3 class="mt-2 font-headline text-lg">{t}</h3>
              <p class="mt-2 text-sm text-text-tertiary">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="max-w-2xl">
      <h2 class="text-2xl">Built with students and counselors</h2>
      <p class="mt-4 text-lg leading-relaxed text-text-tertiary">
        Mascot AI was designed and tested in private beta with 20 high school students and 2 school
        counselors. The voice conversations, the matching logic, and the essay coaching were all
        shaped by watching students use the product and hearing from the counselors who guide them
        every day. That work is still going.
      </p>
      <p class="mt-4 text-sm text-text-muted">
        Mascot AI is in private beta. Features, data retention, and availability may change.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
