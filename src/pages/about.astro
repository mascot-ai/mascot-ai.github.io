---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { TOTAL_UNIVERSITIES } from '../lib/site.js';

const steps = [
  [
    'Set up your profile by talking',
    'Join the platform and have a voice conversation with Mascot. It asks about your interests, activities, grades, and goals, and builds your profile from your answers.',
  ],
  [
    'Get your college matches',
    'Mascot ranks schools against your profile and gives a reason for each one, split into reach, target, and safety.',
  ],
  [
    'Pick matches and see the essays',
    'Choose the schools you want to apply to. Mascot shows you every essay you will need to write for them.',
  ],
  [
    'Write each essay with an agent',
    'Talk an essay through with Mascot to work out what it should be about and pull in details about you. Then draft several versions, get grammar and structure feedback, and refine until it is ready.',
  ],
];
---

<BaseLayout
  path="/about/"
  title="About Mascot AI: College Counseling for Every Student"
  description="A private college counselor costs hundreds an hour. Mascot AI gives every high schooler a Conversational AI Counselor. Built with students and counselors."
>
  <section class="container-x py-16 sm:py-24">
    <h1 class="max-w-3xl text-4xl leading-tight sm:text-5xl">
      College counseling shouldn't depend on who you can afford.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-text-tertiary">
      A private college counselor can cost hundreds of dollars an hour, and most students never
      get one. Mascot AI puts a Conversational AI Counselor in every student's pocket. It knows the
      whole application process, remembers every conversation, and works off real data on
      thousands of schools.
    </p>
  </section>

  <section class="border-y border-border-primary bg-bg-secondary py-16">
    <div class="container-x max-w-3xl">
      <h2 class="text-2xl">How it works, start to finish</h2>
      <ol class="mt-8 space-y-8" data-anim-group>
        {
          steps.map(([t, d], i) => (
            <li class="flex gap-5" data-anim>
              <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-brand-primary/10 font-headline text-sm font-bold text-brand-primary">
                {i + 1}
              </span>
              <div>
                <h3 class="font-headline text-lg">{t}</h3>
                <p class="mt-1 leading-relaxed text-text-tertiary">{d}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="max-w-2xl">
      <h2 class="text-2xl">Built with students and counselors</h2>
      <p class="mt-4 text-lg leading-relaxed text-text-tertiary">
        Mascot AI was designed and tested with high school students and school counselors. The
        voice conversations, the matching logic, and the essay coaching were all shaped by watching
        students use the product and hearing from the counselors who guide them every day. That
        work is still going.
      </p>
    </div>
  </section>

  <section class="border-y border-border-primary bg-bg-secondary py-16">
    <div class="container-x max-w-3xl">
      <h2 class="text-2xl">How we think about AI in admissions</h2>
      <ul class="mt-5 space-y-3 text-text-tertiary">
        <li><strong class="text-text-primary">Your writing stays yours.</strong> Mascot asks questions and critiques. It does not write your essays.</li>
        <li><strong class="text-text-primary">Real data, with reasons.</strong> Matches come from a database of {TOTAL_UNIVERSITIES} schools, and each one explains why it fits so you can disagree.</li>
        <li><strong class="text-text-primary">Students stay in control.</strong> Parents get a read-only view and billing. They never edit a student's work.</li>
        <li><strong class="text-text-primary">Check the facts.</strong> Confirm any deadline or requirement on the school's own website before you rely on it.</li>
      </ul>
      <p class="mt-6 text-sm text-text-tertiary">
        Read our <a href="/privacy/" class="font-medium text-brand-primary hover:underline">privacy policy</a>,
        or see how Mascot <a href="/compare/chatgpt/" class="font-medium text-brand-primary hover:underline">compares with ChatGPT</a>
        and <a href="/compare/private-college-counselor/" class="font-medium text-brand-primary hover:underline">a private counselor</a>.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
