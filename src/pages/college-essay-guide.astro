---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

// Reading order for the essay guide. Posts not listed here are appended by date.
const ORDER = [
  'how-to-choose-college-essay-topic',
  'what-makes-a-college-essay-topic-work',
  'questions-to-find-your-college-essay-story',
  'college-essay-topic-ideas',
  'ordinary-moment-college-essay',
  'college-essay-topics-to-avoid',
  'common-app-essay-prompts-explained',
  'personal-statement-vs-supplemental-essays',
  'why-us-essay-angle',
  'activity-essay-topic',
  'using-ai-for-college-essay',
];
const all = await getCollection('blog', (p) => (import.meta.env.PROD ? !p.data.draft : true));
const rank = (slug) => (ORDER.includes(slug) ? ORDER.indexOf(slug) : ORDER.length);
const posts = all
  .filter((p) => p.data.pillar === 'essay-topic' || p.data.pillar === 'ai-admissions')
  .sort((a, b) => rank(a.slug) - rank(b.slug) || b.data.pubDate.getTime() - a.data.pubDate.getTime());

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'The college essay guide',
  itemListElement: posts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://mascot-ai.com/blog/${p.slug}/`,
    name: p.data.title,
  })),
};
---

<BaseLayout
  path="/college-essay-guide/"
  title="The College Essay Guide: Topics, Prompts and Supplements | Mascot AI"
  description="A start-to-finish college essay guide: find a topic, test it, match it to a Common App prompt, write the supplements, and decide how to use AI. Written by a college counselor."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <section class="container-x max-w-3xl py-16 sm:py-20">
    <p class="eyebrow">Guide</p>
    <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">The college essay guide</h1>
    <p class="mt-5 text-lg leading-relaxed text-text-tertiary">
      Most of the work in a college essay happens before you write a word: finding a topic worth
      writing about. This guide takes you from there to the Common App prompts, supplements, and
      the question of using AI. Read it in order, or jump to the part you need.
    </p>
    <ol class="mt-10 divide-y divide-border-primary border-y border-border-primary">
      {
        posts.map((p, i) => (
          <li class="flex gap-4 py-5">
            <span class="font-headline text-sm font-bold text-brand-primary">{i + 1}</span>
            <div>
              <a href={`/blog/${p.slug}/`} class="font-headline text-lg font-semibold text-text-primary hover:text-brand-primary">
                {p.data.title}
              </a>
              <p class="mt-1 text-sm text-text-tertiary">{p.data.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 text-sm text-text-tertiary">
      Looking for schools instead? See <a href="/college-list-builder/" class="font-medium text-brand-primary hover:underline">the college list builder</a>
      and <a href="/blog/how-to-build-a-balanced-college-list/" class="font-medium text-brand-primary hover:underline">how to build a balanced list</a>.
    </p>
  </section>
  <CtaBand title="Find your essay story" subtitle="Talk it through with Mascot. The writing stays yours." />
</BaseLayout>
