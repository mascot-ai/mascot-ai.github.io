---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import CtaBand from '../components/CtaBand.astro';
import { DEMO_VIDEOS } from '../data/demoVideos.js';

const SITE = 'https://mascot-ai.com';
const more = { student: '/features/', parent: '/parents/', counselor: '/counselors/' };
const schema = Object.values(DEMO_VIDEOS).map((v) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: v.title,
  description: v.summary,
  thumbnailUrl: `${SITE}/videos/${v.id}-poster.jpg`,
  contentUrl: `${SITE}/videos/${v.id}.mp4`,
  uploadDate: '2026-11-07',
}));
---

<BaseLayout
  path="/demo/"
  title="Mascot AI Demo Videos: Students, Parents and Counselors"
  description="Watch Mascot AI in action: a student builds a profile and essays, a parent follows along, and a counselor runs their practice. Three short walkthroughs."
>
  {schema.map((s) => <script type="application/ld+json" slot="head" set:html={JSON.stringify(s)} />)}
  <section class="container-x py-16 text-center sm:py-20">
    <h1 class="text-4xl sm:text-5xl">See Mascot AI in action</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-text-tertiary">
      Three short walkthroughs with the same student, Maya, seen by her, by her parent, and by her counselor.
      Every video has captions and a transcript.
    </p>
  </section>

  {
    Object.values(DEMO_VIDEOS).map((v) => (
      <section id={v.id} class="border-t border-border-primary py-16 sm:py-20">
        <div class="container-x">
          <div class="mx-auto mb-8 max-w-4xl">
            <p class="eyebrow">{v.audience}</p>
            <h2 class="mt-2 text-3xl">{v.title}</h2>
            <a href={more[v.id]} class="mt-2 inline-block text-sm font-medium text-brand-primary hover:underline">
              More for {v.audience.toLowerCase()}
            </a>
          </div>
          <VideoPlayer id={v.id} />
        </div>
      </section>
    ))
  }

  <CtaBand title="Try it with your own profile" subtitle="Create a free account in a minute." />
</BaseLayout>
