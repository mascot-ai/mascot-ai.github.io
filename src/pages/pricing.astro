---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { PRICING, ADDONS } from '../lib/site.js';

// Rows mirror the tier limits in seed_platform_config.py (free vs plus).
const rows = [
  ['Profile builder with voice', true, true],
  ['University search and browse', true, true],
  ['Unlimited essays and drafts', true, true],
  ['Application planner', true, true],
  ['Saved universities', '10', '25'],
  ['AI match runs', '1 a month', '10 a month'],
  ['Voice minutes', '30 total', '60 a month'],
  ['AI credits (essay help, analysis)', '2 to start', 'Refill monthly'],
  ['Transcript upload and parsing', true, true],
];

const faqs = [
  ['Can I switch plans anytime?', 'Yes. Upgrade or downgrade at any time. Changes take effect immediately.'],
  ['What are add-ons?', 'One-time top-ups you can buy on either plan without upgrading: extra voice minutes, AI credits, an extra match run, or more saved-school slots.'],
  ['Is the free plan really free?', "Yes. Explorer is free and doesn't need a card. Writing, search, and the planner have no limits on any plan. Only the AI features are metered."],
  ['Is my data safe?', 'We use encryption in transit and at rest, and we never share your personal information with colleges without your consent.'],
  ['What happens to my essays if I downgrade?', 'Your essays and profile data are always yours. Downgrading only limits AI features, not your saved content.'],
];

const cell = (v) =>
  v === true
    ? '<svg class="mx-auto h-4 w-4 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>'
    : v === false
      ? '<span class="text-text-muted">-</span>'
      : `<span class="text-text-secondary">${v}</span>`;
---

<BaseLayout
  path="/pricing/"
  title="Pricing: Mascot AI"
  description="Explorer is free. Navigator adds more AI matching and essay coaching. Add-ons let you top up on either plan."
>
  <section class="container-x py-16 text-center sm:py-20">
    <h1 class="text-4xl sm:text-5xl">Plans and pricing</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-text-tertiary">
      Start free. Writing is always free. Only the AI features have limits.
    </p>
  </section>

  <section class="container-x pb-16">
    <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2" data-anim-group>
      <div class="rounded-2xl border border-border-primary bg-bg-card p-8" data-anim>
        <h2 class="font-headline text-xl">Explorer</h2>
        <p class="mt-1 text-sm text-text-tertiary">Get started with the core tools.</p>
        <p class="mt-5 text-3xl font-bold">Free</p>
        <a href="#compare" class="btn-ghost mt-6 w-full">See what's included</a>
      </div>
      <div class="relative rounded-2xl border border-brand-primary bg-bg-card p-8" data-anim>
        {
          !PRICING.navigatorLive && (
            <span class="absolute -top-3 left-8 rounded-full bg-brand-primary px-3 py-1 text-xs font-bold text-white">
              Coming soon
            </span>
          )
        }
        <h2 class="font-headline text-xl">Navigator</h2>
        <p class="mt-1 text-sm text-text-tertiary">The full power of AI college counseling.</p>
        <p class="mt-5 text-3xl font-bold">
          {PRICING.navigatorMonthly}<span class="text-base font-normal text-text-muted">/month</span>
        </p>
        <p class="mt-1 text-sm text-text-muted">or {PRICING.navigatorAnnual}/year</p>
        {
          PRICING.navigatorLive ? (
            <a href="#compare" class="btn-primary mt-6 w-full">Compare plans</a>
          ) : (
            <button class="btn-primary mt-6 w-full opacity-60" disabled>Coming soon</button>
          )
        }
      </div>
    </div>
  </section>

  <section id="compare" class="container-x pb-16">
    <div class="mx-auto max-w-4xl overflow-x-auto rounded-2xl border border-border-primary">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border-primary bg-bg-secondary text-left">
            <th class="px-5 py-4 font-semibold">Feature</th>
            <th class="px-5 py-4 text-center font-semibold">Explorer</th>
            <th class="px-5 py-4 text-center font-semibold">Navigator</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(([label, e, n]) => (
              <tr class="border-b border-border-primary last:border-0">
                <td class="px-5 py-4 text-text-secondary">{label}</td>
                <td class="px-5 py-4 text-center" set:html={cell(e)} />
                <td class="px-5 py-4 text-center" set:html={cell(n)} />
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mx-auto mt-3 max-w-4xl text-xs text-text-muted">
      Limits may change during beta. The current limits always show in the app.
    </p>
  </section>

  <section class="container-x pb-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl">Add-ons</h2>
      <p class="mt-2 text-sm text-text-tertiary">
        One-time top-ups on either plan. No upgrade required.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2" data-anim-group>
        {
          ADDONS.map((a) => (
            <div class="flex items-start justify-between rounded-xl border border-border-primary bg-bg-card p-5" data-anim>
              <div>
                <p class="font-medium text-text-primary">{a.name}</p>
                <p class="mt-0.5 text-sm text-text-tertiary">{a.grants}</p>
              </div>
              <span class="font-headline text-lg font-bold text-text-primary">{a.price}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-x pb-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-2xl">Frequently asked questions</h2>
      <dl class="mt-6 space-y-6" data-anim-group>
        {
          faqs.map(([q, a]) => (
            <div data-anim>
              <dt class="font-medium text-text-primary">{q}</dt>
              <dd class="mt-1 text-sm text-text-tertiary">{a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
