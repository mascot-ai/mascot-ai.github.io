---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { TOTAL_UNIVERSITIES } from '../../lib/site.js';

const faqs = [
  ['Can I use ChatGPT for college counseling?', 'You can use any chatbot to brainstorm. For facts like deadlines, costs, and admissions data, check the school\'s own site, because a general chatbot can be wrong or out of date.'],
  ['What does Mascot do that a general chatbot does not?', `Mascot is built for one job. It keeps one profile across sessions, matches you against a database of ${TOTAL_UNIVERSITIES} schools, tracks deadlines in a planner, and gives parents a read-only view.`],
  ['Does Mascot write college essays?', 'No. It helps you find the story and gives feedback on your drafts. The writing stays yours. See our guide on whether it is okay to use AI for your college essay.'],
];
const rows = [
  ['Built for', 'Everything', 'College applications only'],
  ['Your profile', 'What you paste into each chat', 'One profile that builds up across voice sessions'],
  ['School data', 'General knowledge that may be stale', `A school database of ${TOTAL_UNIVERSITIES} institutions with six tabs of data`],
  ['College list', 'Suggestions you must check yourself', 'Ranked matches in reach, target, and safety, with reasons'],
  ['Deadlines and tasks', 'None built in', 'Application planner with deadlines and a checklist'],
  ['Essays', 'Can generate text, which admissions offices discourage', 'Asks questions and critiques. Drafting stays with you'],
  ['Parents', 'No separate role', 'Read-only parent account with billing management'],
  ['Cost', 'Free and paid tiers', 'Free to start'],
];
---

<BaseLayout
  path="/compare/chatgpt/"
  title="Mascot AI vs ChatGPT for College Applications"
  description="Mascot AI vs ChatGPT for college counseling: profile memory, school data, college lists, deadlines, essay help, and what each tool is actually good for."
>
  <section class="container-x max-w-3xl py-16 sm:py-20">
    <p class="eyebrow">Compare</p>
    <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">Mascot AI vs ChatGPT for college applications</h1>
    <p class="mt-5 text-lg leading-relaxed text-text-tertiary">
      ChatGPT is a general-purpose assistant. Mascot AI is a Conversational AI Counselor built only
      for the college application process. Both can talk through ideas with you. They differ in what
      they remember, what data they use, and what they help you finish.
    </p>
    <div class="post mt-10">
      <table>
        <thead>
          <tr><th></th><th>ChatGPT</th><th>Mascot AI</th></tr>
        </thead>
        <tbody>
          {rows.map(([a, b, c]) => <tr><th>{a}</th><td>{b}</td><td>{c}</td></tr>)}
        </tbody>
      </table>

      <h2>Where a general chatbot is fine</h2>
      <p>
        Brainstorming, explaining a concept, or rephrasing a confusing prompt. Just verify any fact
        about a school on the school's own website.
      </p>
      <h2>Where a purpose-built counselor helps</h2>
      <p>
        Keeping the whole process in one place: your profile, your list, your essays, and your
        deadlines. Read
        <a href="/blog/using-ai-for-college-essay/">Is it okay to use AI for your college essay?</a>
        for where the line sits on essays.
      </p>
    </div>
  </section>
  <Faq items={faqs} />
  <CtaBand title="Try it free" subtitle="Start with a voice conversation. No card needed." />
</BaseLayout>
