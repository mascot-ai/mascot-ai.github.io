---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'Mascot AI: Talk through college',
  description = 'Mascot is a voice-first AI college counselor for high schoolers. Talk through your goals, get a personalized college list, and write stronger essays.',
  path = '',
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

// Site-wide structured data. Emitted on every page; Google dedupes by @id.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://mascot-ai.com/#org',
      name: 'Mascot AI',
      url: 'https://mascot-ai.com/',
      logo: 'https://mascot-ai.com/mascot-bear.png',
      description:
        'Voice-first AI college counseling for high school students: profile building, university matching, and essay coaching in one app.',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://mascot-ai.com/#website',
      url: 'https://mascot-ai.com/',
      name: 'Mascot AI',
      publisher: { '@id': 'https://mascot-ai.com/#org' },
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4F46E5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mascot AI" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Apply saved theme + mark JS active before paint (avoids theme flash and
         keeps [data-anim] content visible if the bundle fails to load). -->
    <script is:inline>
      (function () {
        var el = document.documentElement;
        el.classList.add('js');
        var saved = localStorage.getItem('mascot-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) el.classList.add('dark');
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-brand-primary focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../lib/anim.js';
    </script>
  </body>
</html>
