---
import { INSTAGRAM_URL } from '../lib/site.js';
const year = new Date().getFullYear();
---

<footer class="border-t border-border-primary bg-bg-secondary">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5 font-headline text-lg font-extrabold">
        <img src="/mascot-bear-sm.png" alt="" width="28" height="28" class="h-7 w-7 rounded-lg" />
        <span>Mascot AI</span>
      </div>
      <p class="mt-3 max-w-xs text-sm font-semibold text-text-secondary">
        Talk it through. Find your fit. Apply with confidence.
      </p>
      <p class="mt-2 max-w-xs text-sm text-text-tertiary">
        A Conversational AI Counselor for high schoolers. Built with students and counselors.
      </p>
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="me noopener"
        aria-label="Mascot AI on Instagram"
        class="mt-4 inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border-primary text-text-secondary hover:text-text-primary"
      >
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
      </a>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Product</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/features/" class="text-text-secondary hover:text-text-primary">For Students</a></li>
        <li><a href="/parents/" class="text-text-secondary hover:text-text-primary">For Parents</a></li>
        <li><a href="/pricing/" class="text-text-secondary hover:text-text-primary">Pricing</a></li>
        <li><a href="/college-list-builder/" class="text-text-secondary hover:text-text-primary">College List Builder</a></li>
        <li><a href="/blog/" class="text-text-secondary hover:text-text-primary">Guides</a></li>
        <li><a href="/college-essay-guide/" class="text-text-secondary hover:text-text-primary">College Essay Guide</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Company</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/about/" class="text-text-secondary hover:text-text-primary">About</a></li>
        <li><a href="/compare/" class="text-text-secondary hover:text-text-primary">Compare</a></li>
        <li><a href="/coming-soon/" class="text-text-secondary hover:text-text-primary">What's next</a></li>
        <li><a href="/contact/" class="text-text-secondary hover:text-text-primary">Contact</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Legal</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/privacy/" class="text-text-secondary hover:text-text-primary">Privacy</a></li>
        <li><a href="/terms/" class="text-text-secondary hover:text-text-primary">Terms</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border-primary">
    <div
      class="container-x flex flex-col gap-2 py-5 text-xs text-text-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Mascot AI Labs, Inc. All rights reserved.</p>
    </div>
  </div>
</footer>
