---
import { AUTHOR } from '../lib/blog.js';
---

<aside class="mt-14 rounded-2xl border border-border-primary bg-bg-secondary p-6">
  <div class="flex items-center gap-3">
    <img
      src="/mascot-bear.png"
      alt=""
      width="40"
      height="40"
      class="h-10 w-10 rounded-xl bg-brand-primary/10 p-1"
    />
    <p class="font-headline font-bold text-text-primary">{AUTHOR.byline}</p>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-text-tertiary">{AUTHOR.bio}</p>
</aside>
