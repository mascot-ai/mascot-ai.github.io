---
import { AUTHOR } from '../lib/blog.js';
---

<aside class="mt-14 rounded-2xl border border-border-primary bg-bg-secondary p-6">
  <div class="flex items-center gap-3">
    <img
      src="/mascot-bear-sm.png"
      alt=""
      width="40"
      height="40"
      class="h-10 w-10 rounded-xl bg-brand-primary/10 p-1"
    />
    <p class="font-headline font-bold text-text-primary"><a href={AUTHOR.standardsPath} class="hover:underline">{AUTHOR.byline}</a></p>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-text-tertiary">
    {AUTHOR.bio} <a href={AUTHOR.standardsPath} class="font-medium text-brand-primary hover:underline">Read our editorial standards</a>.
  </p>
</aside>
