---
import { APP_LOGIN_URL } from '../lib/site.js';
const {
  title = 'Ready to talk it through?',
  subtitle = 'Talk to your Conversational AI Counselor.',
} = Astro.props;
---

<section class="bg-gradient-to-br from-brand-primary to-indigo-700 py-20 text-white sm:py-24">
  <div class="container-x flex flex-col items-center text-center" data-anim>
    <img src="/mascot-bear.png" alt="" width="64" height="64" class="mb-6 h-16 w-16 rounded-2xl bg-white/10 p-1" />
    <h2 class="max-w-2xl text-3xl text-white sm:text-4xl">{title}</h2>
    <p class="mt-3 max-w-xl text-lg text-indigo-100">{subtitle}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={APP_LOGIN_URL} class="btn bg-white text-brand-primary hover:bg-indigo-50">Log in</a>
    </div>
  </div>
</section>
