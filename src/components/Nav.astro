---
import { NAV_LINKS, BETA_FORM_URL, APP_LOGIN_URL } from '../lib/site.js';
const path = Astro.url.pathname;
---

<header
  data-nav
  class="sticky top-0 z-50 border-b border-transparent bg-bg-primary/80 backdrop-blur transition-colors data-[scrolled]:border-border-primary data-[scrolled]:bg-bg-primary/95"
>
  <nav class="container-x flex items-center justify-between py-3" aria-label="Primary">
    <a href="/" class="flex items-center gap-2.5 font-headline text-lg font-extrabold">
      <img src="/mascot-bear.png" alt="" width="32" height="32" class="h-8 w-8 rounded-lg" />
      <span>Mascot AI</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? 'page' : undefined}
            class="rounded-lg px-3 py-2 text-sm font-medium text-text-secondary transition-colors hover:bg-bg-tertiary hover:text-text-primary aria-[current=page]:text-brand-primary"
          >
            {l.label}
          </a>
        ))
      }
      <button
        data-theme-toggle
        type="button"
        aria-label="Toggle dark mode"
        class="ml-1 rounded-lg p-2 text-text-secondary hover:bg-bg-tertiary"
      >
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <a href={APP_LOGIN_URL} class="btn-ghost ml-1 !px-4 !py-2">Log in</a>
      <a href={BETA_FORM_URL} target="_blank" rel="noopener" class="btn-primary !px-4 !py-2"
        >Request beta access</a
      >
    </div>

    <button
      data-nav-toggle
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      class="rounded-lg p-2 text-text-secondary hover:bg-bg-tertiary md:hidden"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </nav>

  <div
    data-nav-panel
    class="hidden border-t border-border-primary bg-bg-primary data-[open]:block md:!hidden"
  >
    <div class="container-x flex flex-col gap-1 py-3">
      {
        NAV_LINKS.map((l) => (
          <a href={l.href} class="rounded-lg px-3 py-2 text-sm font-medium text-text-secondary hover:bg-bg-tertiary">
            {l.label}
          </a>
        ))
      }
      <a href={APP_LOGIN_URL} class="btn-ghost mt-2">Log in</a>
      <a href={BETA_FORM_URL} target="_blank" rel="noopener" class="btn-primary">Request beta access</a>
    </div>
  </div>
</header>
