---
// Temporary stand-in until real screenshots are captured from the app.
// Replace usages with <img src="/screenshots/<name>.webp" .../> inside <BrowserFrame>.
const { name } = Astro.props;
---

<div
  class="flex min-h-[280px] flex-col items-center justify-center gap-3 bg-[repeating-linear-gradient(45deg,rgb(var(--color-bg-secondary))_0_12px,rgb(var(--color-bg-tertiary))_12px_24px)] p-8 text-center"
>
  <svg class="h-8 w-8 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.6-3.6a2 2 0 0 0-2.8 0L6 20"/></svg>
  <p class="text-sm font-medium text-text-tertiary">Screenshot: {name}</p>
  <p class="text-xs text-text-muted">Captured from the app before launch</p>
</div>
