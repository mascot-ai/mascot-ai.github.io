---
// One feature row: copy on one side, visual (slot) on the other.
const { eyebrow, title, body, bullets = [], reverse = false, id, link } = Astro.props;
---

<section id={id} class="border-b border-border-primary py-20 sm:py-28">
  <div
    class:list={[
      'container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16',
      reverse && 'lg:[&>*:first-child]:order-2',
    ]}
  >
    <div data-anim>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-text-tertiary">{body}</p>
      {
        bullets.length > 0 && (
          <ul class="mt-6 space-y-2.5" data-anim-group>
            {bullets.map((b) => (
              <li class="flex items-start gap-2.5 text-sm text-text-secondary" data-anim>
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        link && (
          <a href={link.href} class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-primary hover:underline">
            {link.label}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        )
      }
    </div>

    <div data-anim>
      <slot />
    </div>
  </div>
</section>
